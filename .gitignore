# Allow-list: ignore everything, then un-ignore tracked paths.
*
!*/

.dub/
.vs/
host/**/bin/
host/**/obj/
examples/**/.dub/

!.gitignore
!LICENSE
!README.adoc
!CHANGELOG.adoc
!AGENTS.md
!VERSION
!dub.sdl
!dprint.jsonc

!.github/
!.github/**

!include/
!include/**

!host/
!host/**
host/**/bin/
host/**/obj/

!source/
!source/**
!tools/
!tools/**
!examples/
!examples/**
!docs/
!docs/**
!changelog-details/
!changelog-details/**

# Keep directory, ignore published native host binaries.
!native/
native/**
!native/.gitkeep
!native/README.adoc

# Build artifacts (re-ignore after allow-list)
*.exe
*.pdb
*.dll
*.lib
*.obj
*.exp
*.o
*.a
*.so
*.dylib
*.log
dub.selections.json
